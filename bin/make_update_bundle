#!/usr/bin/env bash
# make_update_bundle — create ERC-Update.bundle for USB deployment to the Pi.
# Run from anywhere inside the repo. Output is written to the repo root.
#
# Usage:
#   bin/make_update_bundle
#
# The resulting ERC-Update.bundle should be copied to the root of the ERCBACKUP
# USB drive alongside a valid user.txt. Insert the drive into the Pi to deploy.

set -euo pipefail

BUNDLE_NAME="ERC-Update.bundle"

# Always run from repo root
REPO_ROOT=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$REPO_ROOT"

git bundle create "$BUNDLE_NAME" HEAD

echo ""
echo "Created $BUNDLE_NAME ($(git rev-parse --short HEAD))"
echo "Copy to the ERCBACKUP drive root, then insert the drive into the Pi."
