<% content_for :title, "Edit Admin" %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <h2 class="mb-4">Edit <%= @admin.name %></h2>
    <%= form_with model: @admin, url: admin_path(@admin), method: :patch do |f| %>
      <%= render "form", f: f, admin: @admin %>
      <div class="d-flex gap-2">
        <%= f.submit "Save changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", admins_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
