<% content_for :title, "New Admin" %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <h2 class="mb-4">New Admin Account</h2>
    <%= form_with model: @admin, url: admins_path do |f| %>
      <%= render "form", f: f, admin: @admin %>
      <div class="d-flex gap-2">
        <%= f.submit "Create admin", class: "btn btn-primary" %>
        <%= link_to "Cancel", admins_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
