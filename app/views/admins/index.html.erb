<% content_for :title, "Admin Accounts" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Admin Accounts</h2>
  <%= link_to "New Admin", new_admin_path, class: "btn btn-primary" %>
</div>

<table class="table table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Username</th>
      <th>Role</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @admins.each do |admin| %>
      <tr class="<%= "text-muted" unless admin.active %>">
        <td>
          <%= admin.name %>
          <% if admin == current_admin %>
            <span class="badge bg-secondary ms-1">you</span>
          <% end %>
        </td>
        <td class="text-muted"><%= admin.username %></td>
        <td>
          <% if admin.admin? %>
            <span class="badge bg-danger">Admin</span>
          <% else %>
            <span class="badge bg-secondary">Viewer</span>
          <% end %>
        </td>
        <td>
          <% if admin.active %>
            <span class="badge bg-success">Active</span>
          <% else %>
            <span class="badge bg-light text-dark border">Inactive</span>
          <% end %>
        </td>
        <td class="text-end">
          <%= link_to "Edit", edit_admin_path(admin), class: "btn btn-sm btn-outline-secondary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
