<% content_for :title, "Settings" %>

<h2 class="mb-4">Settings</h2>

<div class="row g-4">

  <%# Editable settings %>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header fw-semibold">General</div>
      <div class="card-body">
        <%= form_with url: settings_path, method: :patch do |f| %>
          <div class="mb-3">
            <label class="form-label">Default Site Code</label>
            <input type="text" inputmode="numeric" name="default_site_code" value="<%= @default_site_code %>"
                   class="form-control" autocomplete="off" data-1p-ignore>
            <div class="form-text">Pre-filled when adding a new member.</div>
          </div>
          <div class="mb-3">
            <div class="form-check">
              <input type="checkbox" name="max3_debug" value="1" id="max3_debug"
                     class="form-check-input" <%= "checked" if @max3_debug %>>
              <label class="form-check-label" for="max3_debug">
                Log verbose serial transcript
              </label>
              <div class="form-text">Writes TX/RX hex to <code>log/max3_debug.log</code>. Included in USB backups.</div>
            </div>
          </div>
          <%= f.submit "Save", class: "btn btn-primary" %>
        <% end %>
        <% if @debug_log_size %>
          <div class="mt-3 d-flex align-items-center gap-2">
            <span class="text-muted small">Log: <%= (@debug_log_size / 1024.0).round(1) %> KB</span>
            <%= button_to "Purge", purge_debug_log_settings_path, method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  data: { confirm: "Delete the debug log file?" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Read-only system info %>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header fw-semibold">System</div>
      <div class="card-body">
        <dl class="mb-0">
          <dt class="text-muted small">Rolling Counter</dt>
          <dd class="mb-3">
            <span class="font-monospace fs-5"><%= @rolling_counter_hex %></span>
            <span class="text-muted ms-2">(<%= @rolling_counter_dec %> / 65535)</span>
            <div class="progress mt-1" style="height:6px">
              <div class="progress-bar" style="width:<%= (@rolling_counter_dec / 65535.0 * 100).round %>%"></div>
            </div>
            <div class="form-text">Managed automatically by the sync process. Do not edit manually.</div>
          </dd>

          <dt class="text-muted small">Total Members</dt>
          <dd class="mb-3"><%= User.count %></dd>

          <dt class="text-muted small">Pending Sync</dt>
          <dd class="mb-0"><%= User.pending_sync.count %></dd>
        </dl>
      </div>
    </div>
  </div>

</div>
