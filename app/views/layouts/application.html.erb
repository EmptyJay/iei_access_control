<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ERC Access Control" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <!-- Bootstrap 5 + Icons (vendored locally) -->
    <link href="/vendor/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/vendor/bootstrap.min.css" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">ERC Access Control</a>
        <div class="navbar-nav ms-auto align-items-center">
          <% if logged_in? %>
            <%= link_to "Dashboard", root_path, class: "nav-link" %>
            <%= link_to "Members", users_path, class: "nav-link" %>
            <%= link_to "Event Log", access_events_path, class: "nav-link" %>
            <%= link_to "Settings", edit_settings_path, class: "nav-link" %>
            <% if current_admin.admin? %>
              <%= link_to "Admins", admins_path, class: "nav-link" %>
            <% end %>
            <span class="navbar-text text-white-50 small ms-2 me-1">
              <%= current_admin.name %>
              <span class="badge <%= current_admin.admin? ? "bg-danger" : "bg-secondary" %> ms-1"><%= current_admin.role.capitalize %></span>
            </span>
            <%= button_to "Log out", logout_path, method: :delete, class: "btn btn-outline-light btn-sm ms-1" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="/vendor/bootstrap.bundle.min.js"></script>

    <div id="loading-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center; flex-direction:column; gap:1rem;">
      <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status"></div>
      <div id="loading-message" class="text-white fs-5 fw-semibold text-center px-4"></div>
      <div id="loading-bar-wrap" style="display:none; width:320px; max-width:80vw;">
        <div class="progress" style="height:8px;">
          <div id="loading-bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"></div>
        </div>
        <div id="loading-detail" class="text-white-50 small text-center mt-1"></div>
      </div>
      <div class="text-white-50 small">Do not close this tab.</div>
    </div>
    <script>
      function showLoading(message) {
        document.getElementById('loading-message').textContent = message;
        document.getElementById('loading-bar-wrap').style.display = 'none';
        document.getElementById('loading-overlay').style.display = 'flex';
      }

      function startStream(url, confirmMsg) {
        if (confirmMsg && !confirm(confirmMsg)) return;

        const overlay  = document.getElementById('loading-overlay');
        const msgEl    = document.getElementById('loading-message');
        const barWrap  = document.getElementById('loading-bar-wrap');
        const barEl    = document.getElementById('loading-bar');
        const detailEl = document.getElementById('loading-detail');

        msgEl.textContent    = 'Connecting…';
        detailEl.textContent = '';
        barEl.style.width    = '0%';
        barWrap.style.display = 'none';
        overlay.style.display = 'flex';

        const source = new EventSource(url);

        source.addEventListener('progress', function(e) {
          const d = JSON.parse(e.data);
          if (d.message) msgEl.textContent = d.message;
          if (d.total > 0) {
            barWrap.style.display = '';
            barEl.style.width = Math.round(d.current / d.total * 100) + '%';
            detailEl.textContent = d.current + ' of ' + d.total;
          } else if (d.current > 0) {
            barWrap.style.display = 'none';
            detailEl.textContent = d.current + ' processed';
          }
        });

        source.addEventListener('done', function(e) {
          source.close();
          window.location.reload();
        });

        source.addEventListener('failure', function(e) {
          source.close();
          overlay.style.display = 'none';
          let msg = 'Operation failed.';
          try { msg = JSON.parse(e.data).error || msg; } catch(_) {}
          alert('Error: ' + msg);
        });

        source.onerror = function() {
          source.close();
          overlay.style.display = 'none';
          alert('Connection lost. Please reload and check the result.');
        };
      }
    </script>
  </body>
</html>
